# Copy to .env in the repository root. Do not commit .env.
# The Java API reads this file. System environment variables override it.
#
# Windows CMD:
#   copy .env.example .env
#   notepad .env

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# MySQL 8. The API creates the database, applies backend/db/mysql/schema.sql,
# and loads demo rows only when the users table is empty.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=petroflow
MYSQL_USER=root
MYSQL_PASSWORD=

# Same values, if you prefer the PETROFLOW_ names. Either pair works.
# PETROFLOW_DB_HOST=127.0.0.1
# PETROFLOW_DB_PORT=3306
# PETROFLOW_DB_NAME=petroflow
# PETROFLOW_DB_USER=root
# PETROFLOW_DB_PASSWORD=

SESSION_COOKIE_NAME=pf_session
SESSION_TTL_HOURS=12
# true only behind HTTPS. On a pump LAN using http:// keep this false,
# otherwise the browser will drop the login cookie.
COOKIE_SECURE=false

# First boot of an empty database loads the demo company. Set false before
# real dealer data, so a wiped database is not silently refilled with demo rows.
SEED_DEMO_DATA=true
ENABLE_DEMO_TOOLS=true
DEMO_PASSWORD=PetroFlow@2025

# --- sign-in throttling (audit A5) ---
# Failed sign-ins are counted per client IP and per normalised account email inside a rolling
# window. Both limits are enforced; attempts are stored in MySQL (login_throttle_attempts) so the
# limits also hold across API restarts and multiple API processes. Successful sign-in clears only
# that account's counter, and counters expire with the window, so nobody is locked out forever.
PETROFLOW_LOGIN_WINDOW_SECONDS=900
PETROFLOW_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=8
PETROFLOW_LOGIN_MAX_ATTEMPTS_PER_IP=30

# --- reverse proxy (audit A5) ---
# X-Forwarded-For is IGNORED unless you opt in here. Only enable this when the API is behind a
# reverse proxy you control, and list that proxy's exact address(es). Without the list the API
# refuses to start, because a forged header would let one attacker rotate IPs at will.
# PETROFLOW_TRUST_PROXY=true
# PETROFLOW_TRUSTED_PROXIES=10.0.0.5

# Vite uses this only on the machine that runs the frontend. The browser
# always calls /api on the same host. Do not point this at a public URL.
PETROFLOW_API_URL=http://127.0.0.1:4000

# Optional local hardware agent. Not required to run the ERP screens.
GATEWAY_SYNC_TOKEN=
PETROFLOW_DEVICE_KEY=
PETROFLOW_STATION_ID=
PETROFLOW_SPOOL_FILE=backend/db/gateway-spool.ndjson
PETROFLOW_GATEWAY_FAILOVER=true

# --- first owner on a clean production database (audit D1/D2) ---
# Demo seeding is disabled in production, so the first real login is created by a one-time
# command instead of an HTTP endpoint:
#   cd backend && gradlew.bat run --args="--bootstrap-owner"
# It asks for the email, company details and password on the terminal (never on the command line),
# stores the password as a PBKDF2 hash, creates the account with is_demo=0, and refuses to run again
# once an owner exists or once it has completed. No configuration variable is needed for it.
#
# --- reset protection (audit D6) ---
# --reset-db / `npm run db:reset` drop every table and are refused when NODE_ENV=production,
# before any SQL runs. They stay available in development and tests.

# --- production example (pump PC or server) ---
# NODE_ENV=production
# ENABLE_DEMO_TOOLS=false
# SEED_DEMO_DATA=false
# COOKIE_SECURE=true
# MYSQL_PASSWORD=change-me
#
# In production both demo flags already default to false, and setting either of them to true
# stops the API at startup instead of silently creating demo logins. On first boot in production
# the API also refuses to start if the database still contains any demo account
# (superadmin@petroflow.dev, owner/manager/attendant@sunrisefuels.in, or any row with is_demo=1).
# It never deletes or disables those rows itself — see the startup message for the manual steps.
#
# COOKIE_SECURE=true requires HTTPS. Only lower it if you deliberately serve the ERP over plain
# HTTP on an isolated pump LAN, and understand that session cookies then travel unencrypted.
