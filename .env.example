# Copy to .env in the repository root. Do not commit .env.
# The Java API reads this file. System environment variables override it.
#
# Windows CMD:
#   copy .env.example .env
#   notepad .env

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# MySQL 8. The API creates the database, applies backend/db/mysql/schema.sql,
# and loads demo rows only when the users table is empty.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=petroflow
MYSQL_USER=root
MYSQL_PASSWORD=

# Same values, if you prefer the PETROFLOW_ names. Either pair works.
# PETROFLOW_DB_HOST=127.0.0.1
# PETROFLOW_DB_PORT=3306
# PETROFLOW_DB_NAME=petroflow
# PETROFLOW_DB_USER=root
# PETROFLOW_DB_PASSWORD=

SESSION_COOKIE_NAME=pf_session
SESSION_TTL_HOURS=12
# true only behind HTTPS. On a pump LAN using http:// keep this false,
# otherwise the browser will drop the login cookie.
COOKIE_SECURE=false

# First boot of an empty database loads the demo company. Set false before
# real dealer data, so a wiped database is not silently refilled with demo rows.
SEED_DEMO_DATA=true
ENABLE_DEMO_TOOLS=true
DEMO_PASSWORD=PetroFlow@2025

# Vite uses this only on the machine that runs the frontend. The browser
# always calls /api on the same host. Do not point this at a public URL.
PETROFLOW_API_URL=http://127.0.0.1:4000

# Optional local hardware agent. Not required to run the ERP screens.
GATEWAY_SYNC_TOKEN=
PETROFLOW_DEVICE_KEY=
PETROFLOW_STATION_ID=
PETROFLOW_SPOOL_FILE=backend/db/gateway-spool.ndjson
PETROFLOW_GATEWAY_FAILOVER=true

# --- production example (pump PC or server) ---
# NODE_ENV=production
# ENABLE_DEMO_TOOLS=false
# SEED_DEMO_DATA=false
# COOKIE_SECURE=false
# MYSQL_PASSWORD=change-me
