# ---------------------------------------------------------------------------
# PetroFlow ERP environment configuration (copy to .env, never commit secrets)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Relative paths are resolved from the repository root.
# Local/dev uses the built-in SQLite engine (see docs/ARCHITECTURE.md).
DATABASE_FILE=db/petroflow.db

# MySQL (production target) — set when running the MySQL adapter:
# DATABASE_URL="mysql://petroflow:change-me@127.0.0.1:3306/petroflow"
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=petroflow
# MYSQL_USER=petroflow
# MYSQL_PASSWORD=change-me

SESSION_COOKIE_NAME=pf_session
SESSION_TTL_HOURS=12
# Must be true behind HTTPS in production
COOKIE_SECURE=false

# Comma-separated extra origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:5173

# Demo tools (simulator triggers, demo reset) — disabled automatically in production.
ENABLE_DEMO_TOOLS=true
DEMO_PASSWORD=PetroFlow@2025

LOG_LEVEL=info

# Shared secret used by the local gateway when syncing config (optional).
GATEWAY_SYNC_TOKEN=

# Local backend origin for Vite's server-side dev proxy and the hardware gateway.
# Browser requests stay relative to /api; this value is never sent to clients.
PETROFLOW_API_URL=http://127.0.0.1:4000
# Optional: set to 443 behind an HTTPS preview proxy; leave blank for localhost.
# PETROFLOW_HMR_CLIENT_PORT=443
PETROFLOW_DEVICE_KEY=
PETROFLOW_STATION_ID=
PETROFLOW_SPOOL_FILE=db/gateway-spool.ndjson
PETROFLOW_GATEWAY_FAILOVER=true
