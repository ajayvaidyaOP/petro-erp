db/*.db-wal
db/*.db-shm
db/backups/
*.sqlite
*.sqlite3

# logs & runtime
logs/
*.log
npm-debug.log*
.pids/

# test / tooling caches
coverage/
.vitest/
playwright-report/
test-results/
.nyc_output/
.eslintcache
.turbo/

# editors & OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
