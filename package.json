{
  "name": "petroflow-erp",
  "private": true,
  "version": "1.0.0",
  "description": "PetroFlow ERP — multi-tenant petrol pump management SaaS for India (React/Vite + Java 21 + MySQL 8)",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/gradle.mjs run --no-daemon",
    "dev:frontend": "npm run dev -w @petroflow/web",
    "dev:server": "npm run dev:backend",
    "dev:web": "npm run dev:frontend",
    "dev:gateway": "node scripts/gradle.mjs simulateGateway --no-daemon",
    "start": "java -jar backend/build/libs/petroflow-1.0.0.jar",
    "build": "npm run build -w @petroflow/web && node scripts/gradle.mjs jar --no-daemon",
    "typecheck": "npm run typecheck -w @petroflow/web && node scripts/gradle.mjs classes testClasses --no-daemon",
    "test": "node scripts/gradle.mjs verifyJava --no-daemon",
    "test:e2e": "playwright test",
    "db:reset": "node scripts/gradle.mjs run --args=\"--reset-db --check-only\" --no-daemon",
    "db:bootstrap": "node scripts/gradle.mjs run --args=\"--bootstrap-owner\" --no-daemon",
    "db:seed": "node scripts/gradle.mjs run --args=\"--check-only\" --no-daemon"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.0"
  }
}
